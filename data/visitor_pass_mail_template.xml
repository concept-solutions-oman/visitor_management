<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_visitor_pass_confirmation" model="mail.template">
            <field name="name">Visitor Pass: Confirmation and QR Code</field>
            <field name="model_id" ref="visitor_management.model_visitor_pass"/>
            <field name="subject">Your Visit Confirmation for ${object.company_id.name}</field>
            <field name="email_to">${object.visitor_email}</field>
            <field name="lang">${object.visitor_id.lang}</field>
            <field name="body_html" type="html">
                <div style="font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p>Dear ${object.visitor_name},</p>
                    
                    <p>Your visit to <strong>${object.company_id.name}</strong> to meet with <strong>${object.host_employee_id.name}</strong> has been confirmed.</p>
                    
                    <div style="background-color: #f9f9f9; padding: 15px; border-radius: 8px; margin: 20px 0;">
                        <strong>Visit Details:</strong>
                        <ul>
                            <li><strong>Host:</strong> ${object.host_employee_id.name}</li>
                            <li><strong>Date &amp; Time:</strong> ${format_datetime(object.planned_check_in, tz=object.host_employee_id.tz or 'UTC')}</li>
                            <li><strong>Reason:</strong> ${object.reason_for_visit or 'N/A'}</li>
                        </ul>
                    </div>

                    <p>Please present the QR code below at the reception to check in upon your arrival.</p>
                    
                    <div style="text-align: center; margin: 25px 0;">
                        <img src="/web/image?model=visitor.pass&amp;id=${object.id}&amp;field=qr_code" alt="Your Visitor Pass QR Code" style="width: 200px; height: 200px;"/>
                    </div>
                    
                    <p>We look forward to seeing you.</p>
                    
                    <p>
                        Best regards,<br/>
                        ${object.company_id.name}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>