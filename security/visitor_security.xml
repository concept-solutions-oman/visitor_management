<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_visitor_management" model="ir.module.category">
            <field name="name">Visitor Management</field>
            <field name="description">Manage visitor passes, check-ins, and employee notifications</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_visitor_security" model="res.groups">
            <field name="name">Security</field>
            <field name="category_id" ref="module_category_visitor_management"/>
            <field name="comment">Can create, update, check-in, and check-out all visitors.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_visitor_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_visitor_management"/>
            <field name="comment">Can create and manage their own visit requests.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_visitor_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_visitor_management"/>
            <field name="comment">Full access to all visitor records and reports.</field>
            <field name="implied_ids" eval="[(4, ref('group_visitor_employee'))]"/>
        </record>

        <record id="visitor_pass_rule_employee" model="ir.rule">
            <field name="name">Employee: Own Visitor Passes</field>
            <field name="model_id" ref="model_visitor_pass"/>
            <field name="domain_force">[('host_employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_visitor_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="visitor_pass_rule_security" model="ir.rule">
            <field name="name">Security: All Visitor Passes</field>
            <field name="model_id" ref="model_visitor_pass"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_visitor_security'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="visitor_pass_rule_manager" model="ir.rule">
            <field name="name">Manager: All Visitor Passes</field>
            <field name="model_id" ref="model_visitor_pass"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_visitor_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>