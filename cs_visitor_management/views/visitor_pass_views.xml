<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_pass_tree" model="ir.ui.view">
        <field name="name">visitor.pass.tree</field>
        <field name="model">visitor.pass</field>
        <field name="arch" type="xml">
            <tree string="Visitor Passes" decoration-success="state=='checked_out'" decoration-info="state=='checked_in'" decoration-muted="state=='cancelled'">
                <field name="planned_check_in"/>
                <field name="visitor_name"/>
                <field name="visitor_phone"/>
                <field name="host_employee_id"/>
                <field name="reason_for_visit" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-success="state=='checked_out'" 
                       decoration-info="state == 'checked_in'"
                       decoration-warning="state=='confirmed'"
                       decoration-muted="state=='draft' or state=='cancelled'"/>
                <field name="check_in_time" optional="hide"/>
                <field name="check_out_time" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_visitor_pass_form" model="ir.ui.view">
        <field name="name">visitor.pass.form</field>
        <field name="model">visitor.pass</field>
        <field name="arch" type="xml">
            <form string="Visitor Pass">
                <header>
                    <button name="action_confirm" 
                            string="Confirm &amp; Send QR" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="cs_visitor_management.group_visitor_employee,cs_visitor_management.group_visitor_security_team,cs_visitor_management.group_visitor_manager"/>
                    
                    <button name="action_check_in" 
                            string="Check-In" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'confirmed'"
                            groups="cs_visitor_management.group_visitor_security,cs_visitor_management.group_visitor_security_team"/>
                    <button name="action_check_out" 
                            string="Check-Out" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ('checked_in')"
                            groups="cs_visitor_management.group_visitor_security,cs_visitor_management.group_visitor_security_team"/>
                    
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object"
                            invisible="state in ('checked_out', 'cancelled')"
                            groups="cs_visitor_management.group_visitor_employee,cs_visitor_management.group_visitor_security_team,cs_visitor_management.group_visitor_manager"/>
                    <button name="action_reset_to_draft" 
                            string="Reset to Draft" 
                            type="object"
                            invisible="state not in ('cancelled')"
                            groups="cs_visitor_management.group_visitor_employee,cs_visitor_management.group_visitor_security_team,cs_visitor_management.group_visitor_manager"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <field name="check_in_by" invisible="1"/>
                    <field name="check_out_by" invisible="1"/>
                    
                    <group>
                        <group id="host_details" string="Host Details">
                            <field name="host_employee_id"/>
                            <field name="planned_check_in"/>
                            <field name="reason_for_visit"/>
                        </group>
                        <group id="visitor_details" string="Visitor Details">
                            <field name="visitor_id" 
                                   placeholder="Select existing visitor..."
                                   context="{'search_default_customer': 0, 'show_address': 1}"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="visitor_name" required="1" placeholder="...or enter new visitor name"/>
                            <field name="visitor_phone" required="1"/>
                            <field name="visitor_email"/>
                            <field name="visitor_company"/>
                        </group>
                        <group id="visit_times" string="Visit Timestamps" invisible="state == 'draft'">
                            <field name="check_in_time" 
                                   readonly="1" 
                                   string="Actual Check-In Time"
                                   invisible="check_in_by == 'security'"/>
                            <field name="check_in_time" 
                                   readonly="1" 
                                   string="Actual Check-In Time (Security)"
                                   invisible="check_in_by != 'security'"/>
                                   
                            <field name="check_out_time" 
                                   readonly="1" 
                                   string="Actual Check-Out Time"
                                   invisible="check_out_by == 'security'"/>
                            <field name="check_out_time" 
                                   readonly="1" 
                                   string="Actual Check-Out Time (Security)"
                                   invisible="check_out_by != 'security'"/>
                        </group>
                        <group id="qr_code" string="Access QR Code" invisible="state == 'draft'">
                            <field name="qr_code" widget="image" nolabel="1"/>
                            <field name="access_token" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_visitor_pass_search" model="ir.ui.view">
        <field name="name">visitor.pass.search</field>
        <field name="model">visitor.pass</field>
        <field name="arch" type="xml">
            <search string="Visitor Passes">
                <field name="visitor_name" string="Visitor"/>
                <field name="visitor_phone" string="Phone"/>
                <field name="host_employee_id"/>
                <filter string="Today's Visits" name="today" 
                        domain="[('planned_check_in', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                ('planned_check_in', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="My Visits" name="my_visits" 
                        domain="[('host_employee_id.user_id', '=', uid)]"
                        groups="cs_visitor_management.group_visitor_employee"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Checked Out" name="checked_out" domain="[('state', '=', 'checked_out')]"/>
                <group expand="0" string="Group By">
                    <filter string="Host Employee" name="group_host" context="{'group_by': 'host_employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Planned Date" name="group_planned_date" context="{'group_by': 'planned_check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visitor_pass" model="ir.actions.act_window">
        <field name="name">Visitor Passes</field>
        <field name="res_model">visitor.pass</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1, 'search_default_checked_in': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visitor passes found
            </p>
            <p>
                Create a new visitor pass to pre-register a visitor.
            </p>
        </field>
    </record>
</odoo>
