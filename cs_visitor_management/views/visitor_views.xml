<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_tree" model="ir.ui.view">
        <field name="name">visitor.visitor.tree</field>
        <field name="model">visitor.visitor</field>
        <field name="arch" type="xml">
            <tree string="Visitors" decoration-success="state=='checked_out'" decoration-info="state=='checked_in'">
                <field name="check_in_time"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="employee_id"/>
                <field name="reason_for_visit" optional="show"/>
                <field name="state" widget="badge" decoration-success="state=='checked_out'" decoration-info="state=='checked_in'"/>
                <field name="check_out_time"/>
            </tree>
        </field>
    </record>

    <record id="view_visitor_form" model="ir.ui.view">
        <field name="name">visitor.visitor.form</field>
        <field name="model">visitor.visitor</field>
        <field name="arch" type="xml">
            <form string="Visitor">
                <header>
                    <button name="action_check_out" 
                            string="Check Out" 
                            type="object" 
                            class="btn-primary"
                            invisible="state == 'checked_out'"/>
                    <field name="state" widget="statusbar" statusbar_visible="checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Visitor Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone" required="1"/>
                            <field name="company"/>
                        </group>
                        <group>
                            <field name="employee_id"
                                   required="1"
                                   readonly="1"
                                   force_save="1"
                                   groups="cs_visitor_management.group_visitor_employee,!cs_visitor_management.group_visitor_manager"/>
                            <field name="employee_id"
                                   required="1"
                                   groups="cs_visitor_management.group_visitor_manager"/>
                            
                            <field name="reason_for_visit"/>
                        </group>
                        <group>
                            <field name="check_in_time" required="1"/>
                            <field name="check_out_time" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes about the visit..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_visitor_search" model="ir.ui.view">
        <field name="name">visitor.visitor.search</field>
        <field name="model">visitor.visitor</field>
        <field name="arch" type="xml">
            <search string="Visitors">
                <field name="name"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="employee_id"/>
                <field name="reason_for_visit"/>
                <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Checked Out" name="checked_out" domain="[('state', '=', 'checked_out')]"/>
                <separator/>
                <filter string="Today" name="today" 
                        domain="[('check_in_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                ('check_in_time', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="This Week" name="week" 
                        domain="[('check_in_time', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                ('check_in_time', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Check-In Date" name="group_checkin" context="{'group_by': 'check_in_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_visitor_kanban" model="ir.ui.view">
        <field name="name">visitor.visitor.kanban</field>
        <field name="model">visitor.visitor</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="employee_id"/>
                <field name="check_in_time"/>
                <field name="state"/>
                <field name="reason_for_visit"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <br/>
                                    <small><field name="phone"/></small>
                                </div>
                                <span class="float-end">
                                    <field name="state" widget="badge" decoration-success="state=='checked_out'" decoration-info="state=='checked_in'"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="employee_id"/>
                                    <br/>
                                    <t t-if="record.reason_for_visit.value">
                                        <small><i class="fa fa-info-circle"/> <field name="reason_for_visit"/></small>
                                    </t>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <small><i class="fa fa-clock-o"/> <field name="check_in_time"/></small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_visitor_visitor" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="res_model">visitor.visitor</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_today': 1, 'search_default_checked_in': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visitors registered yet
            </p>
            <p>
                Visitors will appear here once they check in through the kiosk.
            </p>
        </field>
    </record>
</odoo>
